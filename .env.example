# 브라우저에 노출하지 않는 서버 전용 설정이다.
BACKEND_ORIGIN=http://localhost:8080
APP_ORIGIN=http://localhost:3000
BACKEND_TIMEOUT_MS=10000

# 신뢰 프록시가 외부 입력을 제거하고 단일 IP로 덮어쓰는 헤더만 지정한다(예: x-real-ip).
# 지정 시 해당 헤더가 없거나 IP 형식이 아니면 로그인을 거부한다.
# 직접 접속하는 로컬 개발에서는 비워 둔다. 이때 Spring은 BFF 연결 IP로 제한한다.
TRUSTED_CLIENT_IP_HEADER=

# 32바이트 무작위 값을 Base64로 설정한다. Spring JWT 서명 키와 별도로 생성한다.
# 생성: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# 운영에서는 APP_ORIGIN을 HTTPS로 지정하고 모든 BFF 인스턴스에 같은 키를 공급한다.
AUTH_COOKIE_SECRET=
