# 브라우저에 노출하지 않는 서버 전용 설정이다.
# Next의 NODE_ENV와 구분한 배포 환경: local / dev / prod. dev도 next build + next start로 실행한다.
APP_ENV=local
# 이 PC의 local Spring(8080)·chat(8081)·Node game(8082) 주소와 일치시킨다.
BACKEND_ORIGIN=http://localhost:8080
APP_ORIGIN=http://localhost:3000
CHAT_WEBSOCKET_URL=ws://localhost:8081/ws/chat
GAME_PUBLIC_URL=ws://localhost:8082
BACKEND_TIMEOUT_MS=10000

# 신뢰 프록시가 외부 입력을 제거하고 단일 IP로 덮어쓰는 헤더만 지정한다(예: x-real-ip).
# 지정 시 해당 헤더가 없거나 IP 형식이 아니면 로그인을 거부한다.
# APP_ENV=prod는 이 값이 비어 있으면 서버 시작을 거절한다. 신뢰 프록시의 덮어쓰기와 우회 차단을 함께 설정한다.
# Spring의 AUTH_TRUSTED_PROXY_IPS에도 직접 연결하는 BFF 주소를 등록해야 전달 IP가 적용된다.
# 직접 접속하는 로컬 개발에서는 비워 둔다. 이때 Spring은 BFF 연결 IP로 제한한다.
TRUSTED_CLIENT_IP_HEADER=

# 32바이트 무작위 값을 Base64로 설정한다. Spring JWT 서명 키와 별도로 생성한다.
# 생성: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# 운영에서는 APP_ORIGIN을 HTTPS로 지정하고 모든 BFF 인스턴스에 같은 키를 공급한다.
AUTH_COOKIE_SECRET=

# 운영 BFF→Spring은 HTTPS/mTLS가 필수다. 전용 CA와 BFF 클라이언트 인증서·개인키를 비밀 파일로 마운트한다.
# 운영 BACKEND_ORIGIN은 서버 인증서의 SAN과 일치하는 HTTPS 내부 주소로 변경한다.
# 이 경로와 개인키는 NEXT_PUBLIC 변수·저장소에 넣지 않는다. 인증서 교체 후 BFF 프로세스를 재시작한다.
BACKEND_CA_CERT_PATH=
BFF_CLIENT_CERT_PATH=
BFF_CLIENT_KEY_PATH=

# dev의 Docker 내부 HTTP에서만 사용한다. Spring과 동일한 별도 무작위 32바이트 Base64 키를 공급한다.
# APP_ENV=dev, BACKEND_ORIGIN=http://backend:9080, APP_ORIGIN=http://서버IP:공개포트.
# dev는 개인키 검증 없이 일반 BFF+JWT를 사용한다. prod의 HTTPS·개인키·mTLS 검증은 유지한다.
# Next의 NODE_ENV는 dev로 변경하지 않고 next build + next start를 사용한다.
BFF_DEV_SHARED_SECRET=
